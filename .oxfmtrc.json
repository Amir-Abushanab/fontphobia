{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortPackageJson": true,
  "ignorePatterns": ["packages/*/src/data/**", "**/__golden__/**", "**/CHANGELOG.md", "**/dist/**"]
}
